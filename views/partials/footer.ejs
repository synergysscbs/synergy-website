<style>
    #contact-us {
        background: #000;
        color: #b8c5d6;
        padding: 20px;
        text-align: center;
        position: relative;
        scroll-margin-top: 100px;
        z-index: 30;
    }

    #contact-us .footer-content {
        max-width: 1000px;
        margin: 0 auto;
        padding-top: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
        transition: all 0.3s ease;
    }

    /* Brand block (logo + text together) */
    #contact-us .footer-brand-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    #contact-us .footer-logo {
        width: 200px;
        height: 80px;
        border-radius: 16px;
        object-fit: cover;
        transition: transform 0.3s ease;
        filter: drop-shadow(0 0 12px rgba(68, 204, 255, 0.35));
    }

    #contact-us .footer-logo:hover {
        transform: scale(1.1);
    }

    #contact-us .footer-brand {
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(91deg, #ffffff 0%, #44ccff 100%);
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        transition: all 0.3s ease;
        text-shadow: 0 0 6px rgba(68, 204, 255, 0.4);
    }

    #contact-us .footer-brand:hover {
        transform: translateY(-2px);
    }

    /* Social Icons */
    #contact-us .footer-social {
        display: flex;
        gap: 20px;
        margin-top: 5px;
        margin-bottom: 10px;
    }

    #contact-us .social-icon-footer {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        cursor: pointer;
        font-size: 16px;
        color: black;
    }

    #contact-us .social-icon-footer:hover {
        transform: translateY(-3px) scale(1.1);
        background: #44ccff;
        color: white;
    }

    #scrollToTopBtn {
        position: fixed;
        bottom: 28px;
        right: 28px;

        font-size: 52px;

        width: 60px;
        height: 60px;
        border-radius: 50%;

        background: #44ccff;
        color: #000;
        font-weight: 700;

        border: none;
        cursor: pointer;

        opacity: 0;
        pointer-events: none;
        transform: translateY(10px);

        transition: opacity 0.35s ease, transform 0.35s ease;
        z-index: 1000;

        box-shadow: 0 0 16px rgba(68, 204, 255, 0.55);
        font-family: Arial, sans-serif;
        line-height: 1;
    }

    #scrollToTopBtn.show {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
    }

    /* Responsive logo sizes */
    @media (min-width: 768px) {
        #contact-us .footer-logo {
            width: 250px;
            height: 100px;
        }
    }

    @media (min-width: 1200px) {
        #contact-us .footer-logo {
            width: 250px;
            height: 120px;
        }
    }
</style>

<footer id="contact-us">
    <div class="footer-content">
        <div class="footer-brand-block" id="footer-brand-block">
            <img src="/images/LOGO/synergy grey.png" alt="SYNERGYSSBS Logo" class="footer-logo">
            <div class="footer-brand">SYNERGY | SSCBS</div>
        </div>

        <div class="footer-social">
            <a href="https://www.instagram.com/synergy_sscbs/" class="social-icon-footer" target="_blank"
                rel="noopener noreferrer" aria-label="Instagram">
                <i class="fab fa-instagram"></i>
            </a>
            <a href="https://www.linkedin.com/company/synergy-the-corporate-society-of-sscbs/posts/?feedView=all"
                class="social-icon-footer" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                <i class="fab fa-linkedin-in"></i>
            </a>
        </div>
    </div>
</footer>

<button id="scrollToTopBtn" aria-label="Scroll to top">↑</button>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const brandBlock = document.getElementById('footer-brand-block');
        if (brandBlock) {
            brandBlock.addEventListener('click', () => {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }

        const scrollBtn = document.getElementById('scrollToTopBtn');
        const footer = document.getElementById('contact-us');
        if (!scrollBtn || !footer) return;

        window.addEventListener('scroll', () => {
            const footerTop = footer.getBoundingClientRect().top;
            const windowHeight = window.innerHeight;

            if (footerTop < windowHeight * 0.9) {
                scrollBtn.classList.add('show');
            } else {
                scrollBtn.classList.remove('show');
            }
        });

        scrollBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    });
</script>

