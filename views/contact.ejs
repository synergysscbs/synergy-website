<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%- include('partials/head') %>
    <title>Contact Us</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --bg: #000;
            --panel: rgba(15, 15, 20, 0.75);
            --accent: #44ccff;
            --muted: rgba(255, 255, 255, 0.85);
            --glass-border: rgba(255, 255, 255, 0.06);
            --glass-shadow: rgba(68, 204, 255, 0.08);
            --radius: 14px;
            --container: 1100px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif
        }

        html,
        body {
            height: 100%
        }

        body {
            background: var(--bg);
            color: #fff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: stretch;
            position: relative;
            overflow-x: hidden;
        }

        /* subtle backdrop gradients */
        body::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at 18% 30%, rgba(30, 30, 40, 0.55) 0%, transparent 36%),
                radial-gradient(circle at 78% 72%, rgba(68, 204, 255, 0.08) 0%, transparent 36%);
            z-index: -2;
        }

        .container {
            width: 90%;
            max-width: var(--container);
            margin: 3rem auto;
            padding: 2rem;
            flex: 1;
        }

        header {
            text-align: center;
            margin-bottom: 30px;
            position: relative
        }

        header h1 {
            font-size: clamp(2rem, 5vw, 4rem);
            letter-spacing: 0.18em;
            text-transform: uppercase;
            font-weight: 800;
            background: linear-gradient(90deg, #fff, var(--accent));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 0.4rem;
            text-shadow: 0 8px 30px rgba(68, 204, 255, 0.06);
        }

        header p.subtitle {
            font-size: 1rem;
            opacity: 0.85;
            max-width: 780px;
            margin: 0 auto;
            letter-spacing: 0.02em;
            font-weight: 400;
        }

        /* make the grid cells stretch to match the tallest cell */
        .content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 32px;
            align-items: stretch;
            /* <--- ensures equal heights */
            align-content: start;
        }

        /* panels */
        .panel {
            background: var(--panel);
            border-radius: var(--radius);
            padding: 28px;
            border: 1px solid var(--glass-border);
            box-shadow: 0 10px 30px var(--glass-shadow);
            backdrop-filter: blur(8px) saturate(120%);
            transition: transform .25s ease, box-shadow .25s ease;
            display: flex;
            /* <--- make panels flex containers */
            flex-direction: column;
            /* <--- stack contents vertically */
            height: 100%;
            /* <--- ensure grid child expands fully */
        }

        .panel:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 46px rgba(68, 204, 255, 0.12)
        }

        /* contact info */
        .contact-info .section-title,
        .google-card .section-title {
            display: inline-block;
            font-size: 1.2rem;
            font-weight: 700;
            padding-bottom: 8px;
            border-bottom: 2px solid var(--accent);
            color: var(--accent);
            margin-bottom: 14px
        }

        .info-item {
            display: flex;
            gap: 14px;
            align-items: flex-start;
            margin-bottom: 20px;
            transition: transform .18s ease
        }

        .info-item:hover {
            transform: translateX(6px)
        }

        .info-item .icon {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(180deg, rgba(68, 204, 255, 0.1), rgba(68, 204, 255, 0.05));
            color: var(--accent);
            font-size: 1.05rem;
            box-shadow: 0 6px 18px rgba(68, 204, 255, 0.04);
        }

        .info-content h3 {
            color: var(--accent);
            font-size: 0.98rem;
            margin-bottom: 4px;
            font-weight: 700
        }

        .info-content p {
            color: var(--muted);
            font-weight: 350;
            line-height: 1.5;
            font-size: 0.95rem
        }

        /* clickable links inside info */
        .info-content a {
            color: var(--muted);
            text-decoration: none;
            transition: color .15s ease, transform .12s ease;
        }

        .info-content a:hover {
            color: var(--accent);
            transform: translateY(-2px);
        }

        /* Google Form Card (replaces form) */
        .google-card {
            display: flex;
            flex-direction: column;
            gap: 14px;
            align-items: flex-start;
            justify-content: center;
            min-height: 260px
        }

        .google-card p {
            color: var(--muted);
            line-height: 1.6;
            font-size: 0.97rem
        }

        .form-cta {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 22px;
            border-radius: 999px;
            font-weight: 700;
            text-decoration: none;
            color: #fff;
            background: linear-gradient(135deg, #1d4ed8, var(--accent));
            box-shadow: 0 8px 28px rgba(68, 204, 255, 0.14);
            border: none;
            cursor: pointer;
            transition: transform .18s ease, box-shadow .18s ease;
        }

        .form-cta:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 46px rgba(68, 204, 255, 0.2)
        }

        .form-cta .fa-external-link-alt {
            font-size: 0.95rem;
            opacity: 0.95
        }

        /* small helper row */
        .helper-row {
            display: flex;
            gap: 12px;
            align-items: center;
            margin-top: 6px;
            flex-wrap: wrap
        }

        .helper-row a.mail {
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
            background: transparent
        }

        /* footer small */
        .footer-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-top: 18px;
            flex-wrap: wrap;
            color: rgba(255, 255, 255, 0.7);
            font-weight: 300
        }

        /* responsive */
        @media (max-width:880px) {
            .content {
                grid-template-columns: 1fr;
            }

            .panel {
                padding: 20px
            }
        }

        /* notifications (kept from your design) */
        .notification {
            position: fixed;
            top: 22px;
            right: 22px;
            padding: 14px 18px;
            border-radius: 10px;
            color: white;
            display: flex;
            align-items: center;
            gap: 10px;
            z-index: 1000;
            transform: translateX(100%);
            opacity: 0;
            transition: transform .45s ease, opacity .45s ease;
            backdrop-filter: blur(6px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .notification.show {
            transform: translateX(0);
            opacity: 1
        }

        .notification.success {
            background: rgba(16, 185, 129, 0.95)
        }

        .notification.error {
            background: rgba(239, 68, 68, 0.95)
        }

        .notification .close-btn {
            background: none;
            border: none;
            color: inherit;
            font-size: 1.1rem;
            cursor: pointer;
            opacity: 0.9
        }

        .notification .progress-bar {
            position: absolute;
            left: 0;
            bottom: 0;
            height: 3px;
            width: 100%;
            transform-origin: left;
            background: rgba(255, 255, 255, 0.6)
        }

        /* small animate rule */
        @keyframes progress {
            from {
                transform: scaleX(1)
            }

            to {
                transform: scaleX(0)
            }
        }
    </style>
</head>

<body>

    <!-- replace these includes with your templating engine includes if using EJS -->
    <%- include('partials/navbar') %>

        <div class="container">

            <header>
                <h1>Contact Us</h1>
                <p class="subtitle">Have a question or want to collaborate? Use our Google Form to reach out, we
                    usually reply within 24 hours.</p>
            </header>

            <main class="content" aria-label="Contact page main content">

                <!-- Left: Contact Info -->
                <section class="panel contact-info" aria-labelledby="contact-info-heading">
                    <h2 id="contact-info-heading" class="section-title">Contact Information</h2>

                    <div class="info-item" role="article" aria-label="Email">
                        <div class="icon" aria-hidden="true"><i class="fas fa-envelope"></i></div>
                        <div class="info-content">
                            <h3>Email</h3>
                            <!-- clickable mailto -->
                            <p><a href="mailto:synergy@sscbs.du.ac.in?subject=Website%20Contact"
                                    aria-label="Email synergy">synergy@sscbs.du.ac.in</a></p>
                        </div>
                    </div>

                    <div class="info-item" role="article" aria-label="Phone">
                        <div class="icon" aria-hidden="true"><i class="fas fa-phone"></i></div>
                        <div class="info-content">
                            <h3>Phone</h3>
                            <!-- clickable tel: links with international format -->
                            <p><a href="tel:+917428106643" aria-label="Call Kabir Upneja">Kabir Upneja:
                                    +91-74281-06643</a></p>
                            <p><a href="tel:+919310481081" aria-label="Call Kamya Gulyani">Kamya Gulyani:
                                    +91-93104-81081</a></p>
                        </div>
                    </div>

                    <div class="info-item" role="article" aria-label="Address">
                        <div class="icon" aria-hidden="true"><i class="fas fa-map-marker-alt"></i></div>
                        <div class="info-content">
                            <h3>Address</h3>
                            <p>
                                <a class="address-link" href="https://maps.app.goo.gl/Ak8qccUxMZgFDXk48" target="_blank"
                                    rel="noopener noreferrer" style="color:var(--muted); text-decoration:none;"
                                    aria-label="Open address in Google Maps">
                                    Dr. K.N. Katju Marg Rohini, Sector 16, PSP Area IV, New Delhi, Delhi 110089
                                    <i class="fas fa-external-link-alt"
                                        style="font-size:0.76rem; margin-left:8px; color:var(--accent)"></i>
                                </a>
                            </p>
                        </div>
                    </div>

                    <div class="info-item" role="article" aria-label="Response time">
                        <div class="icon" aria-hidden="true"><i class="fas fa-clock"></i></div>
                        <div class="info-content">
                            <h3>Response Time</h3>
                            <p>We typically respond within 24 hours.</p>
                        </div>
                    </div>

                </section>

                <!-- Right: Google Form CTA (replaces original contact form) -->
                <section class="panel google-card" aria-labelledby="send-message-heading">
                    <h2 id="send-message-heading" class="section-title">Send us a Message</h2>

                    <p>
                        We've moved to a simple Google Form for messages and requests as it helps us keep everything
                        organized.
                        Click the button below to open the form in a new tab.
                    </p>

                    <a class="form-cta" id="googleFormBtn"
                        href="https://docs.google.com/forms/d/e/1FAIpQLSdogQL4ZIyreiDkWAUFWkvZuT-UcPIZomJHsFYmKaciI7lFNA/viewform?usp=publish-editor"
                        target="_blank" rel="noopener noreferrer">
                        <i class="fas fa-external-link-alt"></i>
                        <span>Open Google Form</span>
                    </a>

                    <div class="helper-row">
                        <span style="color:var(--muted);">Prefer email? </span>
                        <a class="mail" href="mailto:synergy@sscbs.du.ac.in">synergy@sscbs.du.ac.in</a>
                    </div>

                    <div style="margin-top:12px; color:rgba(255,255,255,0.75); font-size:0.92rem">
                        <strong>Note:</strong> The form opens in a new tab. Submissions go directly into our inbox and
                        Google Sheets.
                    </div>

                    <!-- keep some space at bottom to match left footer spacing -->
                    <div style="margin-top:auto;"></div>
                </section>

            </main>
        </div>

        <!-- notifications (kept) -->
        <div class="notification success" id="successNotification" role="status" aria-live="polite">
            <i class="fas fa-check-circle"></i>
            <span>Your message has been sent successfully!</span>
            <button class="close-btn" aria-label="Close notification">&times;</button>
            <div class="progress-bar"></div>
        </div>

        <div class="notification error" id="errorNotification" role="status" aria-live="polite">
            <i class="fas fa-exclamation-circle"></i>
            <span>Please fix the errors in the form.</span>
            <button class="close-btn" aria-label="Close notification">&times;</button>
            <div class="progress-bar"></div>
        </div>

        <%- include('partials/footer') %>

            <script>
                // small helper: set year (guarded)
                const yEl = document.getElementById('year');
                if (yEl) yEl.textContent = new Date().getFullYear();
            </script>

            <script src="/javascript/contact.js"></script>
</body>


</html>
