                </p>
                <div class="actions">
                    <a class="btn btn-primary" href="https://unstop.com/college-fests/vincenza-70-x-ey-shaheed-sukhdev-college-of-business-studies-university-of-delhi-440293" target="_blank" rel="noopener noreferrer">
                        Register on Unstop <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    </a>
                    <a class="btn btn-primary" href="https://startupnews.fyi/startup-events/vicenza-7-0-x-ey-new-delhi-19th-march-2026/" target="_blank" rel="noopener noreferrer">
                        View on StartupNews <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    </a>
                    <a class="btn btn-ghost" href="/events#vincenza-7-0">
                        Back to Events <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <a class="btn btn-ghost" href="/contact">
                        Contact Us <i class="fa-regular fa-envelope"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="section section-compact" aria-label="Vincenza 7.0 timeline (dummy)">
        <div class="container">
            <div class="section-divider" aria-hidden="true">
                <div class="line"></div>
                <div class="chip"><i class="fa-solid fa-route"></i> Timeline</div>
                <div class="line"></div>
            </div>

            <p style="margin-top: 6px;">
                Dummy timeline (replace these dates/round names later).
            </p>

            <div class="timeline" role="list" aria-label="Competition timeline">
                <div class="t-step active" role="listitem" aria-label="Current stage: Case submission">
                    <div class="t-k">Now</div>
                    <div class="t-v">Case Submission</div>
                    <div class="t-sub">Ongoing on Unstop</div>
                </div>
                <div class="t-step" role="listitem">
                    <div class="t-k">Next</div>
                    <div class="t-v">Shortlist</div>
                    <div class="t-sub">Dummy date • March 25, 2026</div>
                </div>
                <div class="t-step" role="listitem">
                    <div class="t-k">Round 2</div>
                    <div class="t-v">Live Case</div>
