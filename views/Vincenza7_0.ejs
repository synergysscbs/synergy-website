<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SYNERGY-SSCBS | Vincenza 7.0</title>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">

    <style>
        :root {
            --brand: #44ccff;
            --bg: #0A0A0A;
            --panel: rgba(0, 0, 0, 0.35);
            --text: #ffffff;
            --muted: rgba(255, 255, 255, 0.78);
            --border: rgba(255, 255, 255, 0.14);
            --shadow: rgba(0, 0, 0, 0.55);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
            background: radial-gradient(1200px 800px at 20% 10%, rgba(68, 204, 255, 0.18), transparent 55%),
                linear-gradient(135deg, #060606 0%, #141414 100%);
            color: var(--text);
            overflow-x: hidden;
            min-height: 100vh;
            padding-bottom: 120px; /* room for sticky CTA */
        }

        .container {
            width: 100%;
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 1.25rem;
        }

        .hero {
            min-height: 88vh;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            padding: 64px 0;
        }

        .hero-bg {
            position: absolute;
            inset: 0;
            background: url('/images/Vincenza/vincenza.jpg') center/cover no-repeat;
            filter: saturate(1.05) contrast(1.05) brightness(0.8);
            transform: scale(1.06);
            z-index: -2;
        }

        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.45) 60%, rgba(0, 0, 0, 0.75) 100%);
            z-index: -1;
        }

        /* Subtle hero motion (pure CSS). Remove if you want zero animation. */
        .hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(900px 500px at 20% 30%, rgba(68, 204, 255, 0.16), transparent 60%),
                radial-gradient(700px 400px at 80% 20%, rgba(68, 204, 255, 0.10), transparent 60%);
            opacity: 0.55;
            z-index: -1;
            animation: heroGlow 18s ease-in-out infinite alternate;
        }

        @keyframes heroGlow {
            0% {
                transform: translate3d(-1%, -1%, 0) scale(1.01);
            }

            100% {
                transform: translate3d(1%, 1%, 0) scale(1.04);
            }
        }

        .hero-particles {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: -1;
        }

        .hero-particles span {
            position: absolute;
            width: 8px;
            height: 8px;
            border-radius: 999px;
            background: rgba(68, 204, 255, 0.22);
            box-shadow: 0 0 18px rgba(68, 204, 255, 0.22);
            animation: floatUp 12s linear infinite;
            opacity: 0.75;
        }

        @keyframes floatUp {
            0% {
                transform: translate3d(0, 18vh, 0);
                opacity: 0;
            }

            10% {
                opacity: 0.8;
            }

            100% {
                transform: translate3d(0, -18vh, 0);
                opacity: 0;
            }
        }

        .hero-particles span:nth-child(1) {
            left: 10%;
            top: 68%;
            animation-duration: 13s;
            animation-delay: -2s;
        }

        .hero-particles span:nth-child(2) {
            left: 22%;
            top: 78%;
            width: 6px;
            height: 6px;
            animation-duration: 11s;
            animation-delay: -6s;
        }

        .hero-particles span:nth-child(3) {
            left: 38%;
            top: 72%;
            width: 10px;
            height: 10px;
            animation-duration: 15s;
            animation-delay: -9s;
        }

        .hero-particles span:nth-child(4) {
            left: 52%;
            top: 80%;
            width: 5px;
            height: 5px;
            animation-duration: 10s;
            animation-delay: -4s;
        }

        .hero-particles span:nth-child(5) {
            left: 66%;
            top: 70%;
            width: 9px;
            height: 9px;
            animation-duration: 14s;
            animation-delay: -7s;
        }

        .hero-particles span:nth-child(6) {
            left: 78%;
            top: 76%;
            width: 6px;
            height: 6px;
            animation-duration: 12s;
            animation-delay: -10s;
        }

        .hero-particles span:nth-child(7) {
            left: 88%;
            top: 74%;
            width: 10px;
            height: 10px;
            animation-duration: 16s;
            animation-delay: -5s;
        }

        .hero-particles span:nth-child(8) {
            left: 45%;
            top: 82%;
            width: 7px;
            height: 7px;
            animation-duration: 13s;
            animation-delay: -12s;
        }

        .hero-card {
            text-align: center;
            padding: clamp(18px, 3.5vw, 28px);
            border: 1px solid var(--border);
            border-radius: 22px;
            background: var(--panel);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            box-shadow: 0 18px 70px rgba(0, 0, 0, 0.55);
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            border-radius: 999px;
            font-weight: 800;
            font-size: 0.85rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            border: 1px solid rgba(68, 204, 255, 0.35);
            background: rgba(68, 204, 255, 0.14);
            margin-bottom: 14px;
        }

        .hero-subtitle {
            color: rgba(68, 204, 255, 0.95);
            font-weight: 800;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            margin-bottom: 12px;
            font-size: 0.95rem;
        }

        .hero-title {
            font-weight: 900;
            letter-spacing: 0.02em;
            line-height: 1.05;
            font-size: clamp(2.4rem, 6vw, 4.2rem);
            text-shadow: 0 0 26px rgba(68, 204, 255, 0.22);
        }

        .hero-description {
            margin: 16px auto 0;
            max-width: 70ch;
            color: var(--muted);
            font-size: clamp(1rem, 1.7vw, 1.12rem);
            line-height: 1.75;
        }

        .actions {
            margin-top: 22px;
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 12px 16px;
            border-radius: 14px;
            text-decoration: none;
            font-weight: 900;
            letter-spacing: 0.02em;
            border: 1px solid rgba(255, 255, 255, 0.18);
            transition: transform 160ms ease, background 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
            user-select: none;
        }

        .btn:hover,
        .btn:focus-visible {
            transform: translateY(-2px);
            outline: none;
        }

        .btn-primary {
            color: #00110a;
            background: linear-gradient(90deg, rgba(68, 204, 255, 0.98) 0%, rgba(20, 255, 210, 0.86) 100%);
            border-color: rgba(68, 204, 255, 0.55);
            box-shadow: 0 14px 40px rgba(68, 204, 255, 0.18);
        }

        .btn-ghost {
            color: var(--text);
            background: rgba(0, 0, 0, 0.22);
        }

        .section {
            padding: 54px 0;
        }

        .section-compact {
            padding: 34px 0;
        }

        .section-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 22px 0 14px;
            color: rgba(255, 255, 255, 0.85);
        }

        .section-divider .line {
            height: 1px;
            flex: 1 1 auto;
            background: linear-gradient(90deg, rgba(68, 204, 255, 0.0) 0%, rgba(68, 204, 255, 0.55) 35%, rgba(68, 204, 255, 0.0) 100%);
        }

        .section-divider .chip {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 999px;
            border: 1px solid rgba(68, 204, 255, 0.28);
            background: rgba(68, 204, 255, 0.10);
            font-weight: 900;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            font-size: 0.78rem;
            color: rgba(68, 204, 255, 0.95);
        }

        .section h2 {
            font-size: clamp(1.6rem, 3.4vw, 2.3rem);
            font-weight: 900;
            letter-spacing: 0.02em;
            margin-bottom: 14px;
        }

        .section p {
            color: var(--muted);
            line-height: 1.8;
            font-size: 1.05rem;
        }

        .info-grid {
            margin-top: 20px;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
        }

        .info {
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 16px;
            background: rgba(255, 255, 255, 0.04);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }

        .info .k {
            font-weight: 900;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            font-size: 0.78rem;
            color: rgba(68, 204, 255, 0.95);
        }

        .info .v {
            margin-top: 8px;
            color: rgba(255, 255, 255, 0.9);
            font-weight: 700;
            line-height: 1.4;
        }

        /* ===== Timeline strip (dummy dates) ===== */
        .timeline {
            margin-top: 16px;
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.04);
            border-radius: 20px;
            padding: 16px;
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            box-shadow: 0 18px 60px rgba(0, 0, 0, 0.25);
        }

        .t-step {
            position: relative;
            padding: 14px 14px 14px 14px;
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.10);
            background: rgba(0, 0, 0, 0.18);
        }

        .t-step.active {
            border-color: rgba(68, 204, 255, 0.38);
            box-shadow: 0 0 0 1px rgba(68, 204, 255, 0.18), 0 18px 45px rgba(68, 204, 255, 0.08);
        }

        .t-k {
            font-weight: 900;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            font-size: 0.78rem;
            color: rgba(68, 204, 255, 0.95);
        }

        .t-v {
            margin-top: 10px;
            font-weight: 900;
            font-size: 1.05rem;
            line-height: 1.25;
        }

        .t-sub {
            margin-top: 8px;
            color: rgba(255, 255, 255, 0.72);
            font-weight: 700;
            font-size: 0.92rem;
            line-height: 1.4;
        }

        /* ===== Sponsor/partner row (dummy logos) ===== */
        .sponsor-grid {
            margin-top: 16px;
            display: grid;
            grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 12px;
        }

        .sponsor {
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 14px 12px;
            background: rgba(255, 255, 255, 0.03);
            text-align: center;
            color: rgba(255, 255, 255, 0.9);
            font-weight: 900;
            letter-spacing: 0.01em;
            box-shadow: 0 16px 50px rgba(0, 0, 0, 0.18);
        }

        .sponsor small {
            display: block;
            margin-top: 8px;
            font-weight: 800;
            font-size: 0.78rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: rgba(68, 204, 255, 0.9);
        }

        /* ===== Spotlight stats ===== */
        .spotlight {
            margin-top: 18px;
            border: 1px solid rgba(68, 204, 255, 0.22);
            border-radius: 22px;
            background: radial-gradient(1200px 600px at 20% 0%, rgba(68, 204, 255, 0.12), transparent 55%),
                rgba(0, 0, 0, 0.22);
            padding: 18px;
            box-shadow: 0 22px 70px rgba(0, 0, 0, 0.30);
        }

        .spotlight-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            margin-top: 12px;
        }

        .stat-card {
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 18px;
            padding: 16px;
            background: rgba(0, 0, 0, 0.18);
        }

        .stat-card .big {
            font-size: clamp(1.4rem, 2.8vw, 2.1rem);
            font-weight: 900;
            letter-spacing: 0.01em;
        }

        .stat-card .label {
            margin-top: 8px;
            color: rgba(255, 255, 255, 0.74);
            font-weight: 800;
            line-height: 1.35;
        }

        /* ===== Competition cards: tags + footer CTAs (dummy) ===== */
        .tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin: 12px 0 0;
        }

        .tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, 0.14);
            background: rgba(255, 255, 255, 0.04);
            color: rgba(255, 255, 255, 0.86);
            font-weight: 800;
            font-size: 0.86rem;
            line-height: 1;
        }

        .feature-footer {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 14px;
        }

        .btn-small {
            padding: 10px 12px;
            border-radius: 12px;
            font-weight: 900;
            font-size: 0.92rem;
        }

        .btn-disabled {
            opacity: 0.6;
            cursor: not-allowed;
            filter: grayscale(0.2);
        }

        /* ===== FAQ (pure HTML) ===== */
        .faq {
            margin-top: 16px;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        details {
            border: 1px solid var(--border);
            border-radius: 18px;
            background: rgba(255, 255, 255, 0.03);
            padding: 14px 16px;
        }

        summary {
            cursor: pointer;
            list-style: none;
            font-weight: 900;
            color: rgba(255, 255, 255, 0.92);
        }

        summary::-webkit-details-marker {
            display: none;
        }

        details p {
            margin-top: 12px;
            color: rgba(255, 255, 255, 0.76);
        }

        /* ===== Gallery strip (dummy images) ===== */
        .gallery {
            margin-top: 16px;
            display: grid;
            grid-auto-flow: column;
            grid-auto-columns: minmax(220px, 1fr);
            gap: 12px;
            overflow-x: auto;
            padding-bottom: 8px;
            scroll-snap-type: x mandatory;
        }

        .g-card {
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 18px;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.03);
            scroll-snap-align: start;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
        }

        .g-card img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            display: block;
            filter: saturate(1.05) contrast(1.05);
        }

        .g-meta {
            padding: 12px 12px 14px;
        }

        .g-meta .t {
            font-weight: 900;
            letter-spacing: 0.01em;
        }

        .g-meta .s {
            margin-top: 6px;
            color: rgba(255, 255, 255, 0.72);
            font-weight: 700;
            font-size: 0.92rem;
            line-height: 1.35;
        }

        /* ===== Sticky CTA bar ===== */
        .sticky-cta {
            position: fixed;
            left: 50%;
            transform: translateX(-50%);
            bottom: 14px;
            width: min(980px, 94vw);
            z-index: 999;
            display: flex;
            gap: 10px;
            justify-content: space-between;
            align-items: center;
            padding: 10px 12px;
            border-radius: 18px;
            border: 1px solid rgba(68, 204, 255, 0.22);
            background: rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            box-shadow: 0 22px 80px rgba(0, 0, 0, 0.45);
        }

        .sticky-cta .left {
            min-width: 0;
        }

        .sticky-cta .left .h {
            font-weight: 900;
            letter-spacing: 0.02em;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sticky-cta .left .p {
            margin-top: 4px;
            color: rgba(255, 255, 255, 0.72);
            font-weight: 700;
            font-size: 0.92rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sticky-cta .right {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .sticky-cta .btn {
            padding: 10px 12px;
            border-radius: 14px;
            font-size: 0.95rem;
        }

        @media (prefers-reduced-motion: reduce) {
            .hero::after,
            .hero-particles span {
                animation: none !important;
            }
        }

        .feature-grid {
            margin-top: 22px;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
        }

        .feature-card {
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 18px;
            background: rgba(255, 255, 255, 0.04);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }

        .feature-top {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 10px;
        }

        .feature-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(68, 204, 255, 0.35);
            background: rgba(68, 204, 255, 0.12);
            color: rgba(68, 204, 255, 0.95);
            flex: 0 0 auto;
        }

        .feature-title {
            font-weight: 900;
            font-size: 1.25rem;
            letter-spacing: 0.01em;
        }

        .feature-subtitle {
            margin-top: 2px;
            color: rgba(255, 255, 255, 0.74);
            font-weight: 700;
            font-size: 0.95rem;
        }

        .quote {
            margin-top: 16px;
            padding: 18px;
            border-radius: 18px;
            border: 1px solid rgba(68, 204, 255, 0.28);
            background: rgba(0, 0, 0, 0.22);
            box-shadow: 0 14px 45px rgba(0, 0, 0, 0.35);
        }

        .quote p {
            color: rgba(255, 255, 255, 0.88);
            font-weight: 700;
            line-height: 1.9;
        }

        @media (max-width: 820px) {
            .info-grid {
                grid-template-columns: 1fr;
            }

            .feature-grid {
                grid-template-columns: 1fr;
            }

            .timeline {
                grid-template-columns: 1fr;
            }

            .spotlight-grid {
                grid-template-columns: 1fr;
            }

            .sponsor-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .faq {
                grid-template-columns: 1fr;
            }

            .sticky-cta .left .p {
                display: none;
            }
        }
    </style>
</head>

<body>
    <%- include('partials/navbar') %>

    <section class="hero" aria-label="Vincenza 7.0 hero section">
        <div class="hero-bg"></div>
        <div class="hero-particles" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="container">
            <div class="hero-card">
                <div class="badge"><i class="fa-solid fa-bolt"></i> Case Submission Round: Ongoing</div>
                <p class="hero-subtitle">The Flagship Corporate Conclave of SSCBS</p>
                <h1 class="hero-title">EY x Vincenza 7.0</h1>
